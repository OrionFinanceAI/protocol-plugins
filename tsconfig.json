{
  "compilerOptions": {
    "target": "es2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@orion-finance/protocol/types/ethers-contracts/*": [
        "node_modules/@orion-finance/protocol/types/ethers-contracts/*"
      ]
    }
  },
  "files": ["./hardhat.config.ts"],
  "include": ["test/**/*.ts"],
  "exclude": ["**/*.js", "node_modules"]
}
