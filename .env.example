# cp .env.example .env

PRIVATE_KEY=0x
# Chain-scoped RPC only (no bare RPC_URL). Localhost is fixed in hardhat.config.
SEPOLIA_RPC_URL=
# MAINNET_RPC_URL=
# Enables post-deploy verification on explorers (set SKIP_VERIFY=1 to opt out)
ETHERSCAN_API_KEY=

# OrionConfig for PLUGIN=router, tvl, apy-equal, apy-weighted only (ignored otherwise).
# --network mainnet → MAINNET_*; sepolia / hardhat / localhost → SEPOLIA_*.
# No ORION_CONFIG_ADDRESS. No defaults.
# SEPOLIA_ORION_CONFIG_ADDRESS=
#   Sepolia (comment only, never a code default): 0xbDe3025d08681a02a1c6cf70375baBe2152DD06f
# MAINNET_ORION_CONFIG_ADDRESS=

# Optional, per PLUGIN (see README table)
# OWNER=
# TVL_CAP=
# CREDENTIAL=
# DENYLIST=
# ATTESTER=
# EIP712_NAME=
# EIP712_VERSION=
# ENS_REGISTRY=
# ROOT_NODE=
# EAS=
# SCHEMA_UID=
# TRUSTED_ATTESTERS=
# POLICY_MODE=0
# EMAIL_DOMAIN_HASH=
# COUNTRY_CODES=
# GATES=
# STRATEGIST_K=10
# VAULT_ADDRESS=   # KBest: vault whose manager is PRIVATE_KEY; links via updateStrategist
# SKIP_VERIFY=     # set to 1 to skip post-deploy verification
