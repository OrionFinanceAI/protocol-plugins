# cp .env.example .env

PRIVATE_KEY=0x
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# OrionConfig for PLUGIN=router, tvl, apy-equal, apy-weighted only (ignored otherwise).
# Defaulted on --network sepolia; required for those plugins on every other network.
SEPOLIA_ORION_CONFIG_ADDRESS=0xbDe3025d08681a02a1c6cf70375baBe2152DD06f

# Optional, per PLUGIN (see README table)
# OWNER=
# TVL_CAP=
# CREDENTIAL=
# DENYLIST=
# ATTESTER=
# EIP712_NAME=
# EIP712_VERSION=
# ENS_REGISTRY=
# ROOT_NODE=
# EAS=
# SCHEMA_UID=
# TRUSTED_ATTESTERS=
# POLICY_MODE=0
# EMAIL_DOMAIN_HASH=
# COUNTRY_CODES=
# GATES=
# STRATEGIST_K=10
# VAULT_ADDRESS=   # KBest: vault whose manager is PRIVATE_KEY; links via updateStrategist
# SKIP_VERIFY=
